# API keys (at least one is required)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Optional: OpenAI customization
# OPENAI_API_BASE=https://your-custom-endpoint-if-needed.com
# OPENAI_ORGANIZATION=your-organization-id-if-needed

# Configuration for API calls
DEFAULT_MODEL=claude-3-7-sonnet-20250219  # Or gpt-4o-2024-05-13 if using OpenAI
MAX_TOKENS=4096 